# The Sandbox — Environment Configuration
# Copy this file to .env and fill in your API keys

# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AI...
TOGETHER_API_KEY=...          # Powers: Llama, DeepSeek R1, Qwen 3.5
GROQ_API_KEY=gsk_...
GROQ_API_KEY_2=gsk_...          # optional — rotated per round to avoid rate limits
GROQ_API_KEY_3=gsk_...          # optional — add more keys as needed
GROQ_API_KEY_SUMMARY=gsk_...    # optional — dedicated key for round summarization (avoids gameplay rate limits)

# Server Configuration
HOST=127.0.0.1
PORT=8000
# SESSION_ID=            # Leave unset to auto-generate timestamp-based IDs (session_YYYYMMDD_HHMMSS)

# Game Configuration (optional overrides)
# TIMER_MULTIPLIER=1.0    # Set to 0.1 for fast testing
# MAX_PLAYERS=6
