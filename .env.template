# The Sandbox — Environment Configuration
# Copy this file to .env and fill in any keys for the providers you want to use.
# Leave keys you don't need blank — agents from those providers will show as
# "Unavailable" in the host dashboard but won't cause errors.

# ============================================================
# Frontier model providers (one key per provider)
# ============================================================

# Anthropic — Claude Opus 4.6
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — GPT-5.5, GPT-5.3 Codex
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google — Gemini 3.1 Pro
# Get a key: https://aistudio.google.com/  (free tier available)
GOOGLE_API_KEY=AIza...

# Moonshot AI — Kimi K2.5, Kimi K2.6
# Get a key: https://platform.moonshot.ai/
MOONSHOT_API_KEY=sk-...

# xAI — Grok 4.3
# Get a key: https://console.x.ai/  (no free tier; usually $25 credit on signup)
XAI_API_KEY=xai-...

# DeepSeek — DeepSeek V4 Pro, V4 Flash
# Get a key: https://platform.deepseek.com/  (V4 Pro promo through 2026-05-31)
DEEPSEEK_API_KEY=sk-...

# ============================================================
# Together AI — open-weight hosting (Llama, etc.)
# ============================================================

# Get a key: https://api.together.ai/
TOGETHER_API_KEY=...

# ============================================================
# Groq — fast inference (Llama 4 Scout, Llama 3.3 70B, Qwen 3, etc.)
# ============================================================
# Get a key: https://console.groq.com/keys
# Up to 5 keys can be loaded — pool rotates per round to avoid rate limits.
# Only GROQ_API_KEY is required; the rest are optional and improve throughput.

GROQ_API_KEY=gsk_...
GROQ_API_KEY_2=gsk_...          # optional — added to round-robin pool
GROQ_API_KEY_3=gsk_...          # optional — added to round-robin pool
GROQ_API_KEY_4=gsk_...          # optional — added to round-robin pool
GROQ_API_KEY_5=gsk_...          # optional — added to round-robin pool

# Dedicated Groq key for cross-round LLM summarization (game events + thinking).
# Strongly recommended for any real research run — without it, summaries
# fall back to plain Python truncation. Free tier is plenty for this.
GROQ_API_KEY_SUMMARY=gsk_...

# ============================================================
# Server configuration
# ============================================================

HOST=127.0.0.1
PORT=8000
# SESSION_ID=            # Leave unset to auto-generate timestamp-based IDs (session_YYYYMMDD_HHMMSS)

# ============================================================
# Game configuration (optional overrides)
# ============================================================

# TIMER_MULTIPLIER=1.0    # Set to 0.3 for --fast mode (used by launcher.py)
# MAX_PLAYERS=6

# ============================================================
# No key needed
# ============================================================
# - Mock agents (`mock` in registry) — purely scripted, no API calls.
